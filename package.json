{
	"name": "sidebar-webview-example",
	"displayName": "Sidebar Webview Example",
	"description": "Minimal sidebar webview example",
	"version": "0.0.1",
	"engines": {
	  "vscode": "^1.60.0"
	},
	"categories": ["Other"],
	"activationEvents": ["onView:sidebarWebviewView"],
	"main": "./out/extension.js",
	"contributes": {
	  "views": {
		"explorer": [
		  {
			"type": "webview",
			"id": "sidebarWebviewView",
			"name": "Sidebar Webview"
		  }
		]
	  }
	},
	"scripts": {
	  "vscode:prepublish": "npm run compile",
	  "compile": "tsc -p ./",
	  "watch": "tsc -watch -p ./"
	},
	"devDependencies": {
	  "@types/node": "^16.x",
	  "@types/vscode": "^1.60.0",
	  "typescript": "^4.x"
	}
  }