{
	"name": "cspeed",
	"displayName": "CSpeed",
	"description": "Minimal sidebar webview example with a hardened webview baseline",
	"version": "0.0.1",
	"engines": {
	  "vscode": "^1.74.0"
	},
	"categories": ["Other"],
	"activationEvents": ["onView:sidebarWebviewView"],
	"main": "./out/extension.js",
	"contributes": {
	  "views": {
		"explorer": [
		  {
			"type": "webview",
			"id": "sidebarWebviewView",
			"name": "Sidebar Webview"
		  }
		]
	  }
	},
	"scripts": {
	  "vscode:prepublish": "npm run compile",
	  "compile": "tsc -p ./",
	  "check": "scripts/check-baseline.sh",
	  "lint": "eslint src --ext ts",
	  "test": "npm run compile && npm run check",
	  "watch": "tsc -watch -p ./"
	},
	"devDependencies": {
	  "@eslint/js": "^9.13.0",
	  "@stylistic/eslint-plugin": "^2.9.0",
	  "@types/node": "^20",
	  "@types/vscode": "^1.73.0",
	  "@types/vscode-webview": "^1.57.0",
	  "eslint": "^9.13.0",
	  "typescript": "^5.7.2",
	  "typescript-eslint": "^8.16.0"
	}
  }
