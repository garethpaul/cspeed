{
	"name": "cspeed",
	"displayName": "CSpeed",
	"description": "Minimal sidebar webview example with a hardened webview baseline",
	"version": "0.0.1",
	"engines": {
	  "node": ">=22.13.0 <25",
	  "vscode": "^1.120.0"
	},
	"categories": ["Other"],
	"activationEvents": ["onView:sidebarWebviewView"],
	"main": "./out/extension.js",
	"contributes": {
	  "views": {
		"explorer": [
		  {
			"type": "webview",
			"id": "sidebarWebviewView",
			"name": "Sidebar Webview"
		  }
		]
	  }
	},
	"scripts": {
	  "vscode:prepublish": "npm run compile",
	  "compile": "tsc -p ./",
	  "check:generated": "npm run compile && git diff --exit-code -- out",
	  "check": "scripts/check-baseline.sh",
	  "lint": "eslint src --ext ts --max-warnings=0",
	  "test": "npm run compile && node --test && npm run check",
	  "verify": "npm run lint && npm test && npm run check:generated && npm audit --audit-level=moderate",
	  "watch": "tsc -watch -p ./"
	},
	"devDependencies": {
	  "@eslint/js": "10.0.1",
	  "@stylistic/eslint-plugin": "5.10.0",
	  "@types/node": "22.19.21",
	  "@types/vscode": "1.120.0",
	  "@types/vscode-webview": "1.57.5",
	  "eslint": "10.5.0",
	  "typescript": "6.0.3",
	  "typescript-eslint": "8.62.0"
	}
  }
